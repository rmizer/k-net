# Copy to backend/.env for local development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Slack notifications (optional; leave SLACK_BOT_TOKEN empty to turn them off).
# Check the setup with: python manage.py slack_check --post
SLACK_BOT_TOKEN=
SLACK_ANNOUNCEMENTS_CHANNEL=#announcements
# Defaults to the announcements channel when empty.
SLACK_ALERTS_CHANNEL=
# Invite link to the K-Net Slack workspace, shown to signed-in users.
SLACK_INVITE_URL=

# Public address of the app, used for links in emails and Slack messages.
SITE_URL=http://localhost:5173

# Verification emails are sent from this Gmail account using an app password
# (Google Account > Security > 2-Step Verification > App passwords).
# Leave EMAIL_APP_PASSWORD empty to print emails to the console instead.
SUPPORT_EMAIL=support.knet@gmail.com
EMAIL_APP_PASSWORD=

# Production (Railway). DATABASE_URL comes from the PostgreSQL service;
# DATA_DIR is where the persistent volume is mounted (uploads live there).
# DATABASE_URL=postgresql://...
# DATA_DIR=/data
# Seconds browsers remember to use HTTPS only; raise to 31536000 once it's confirmed working.
# DJANGO_HSTS_SECONDS=3600
